* text=auto

*.cs text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf
*.unity text eol=lf
*.asset text eol=lf
*.meta text eol=lf

# Unity serializes empty YAML scalar values with a trailing space.
*.unity -whitespace
*.asset -whitespace
*.meta -whitespace
LICENSE -whitespace
LICENSES/*.txt -whitespace

*.dll binary
*.so binary
*.aar binary
*.png binary
*.jpg binary
*.jpeg binary
